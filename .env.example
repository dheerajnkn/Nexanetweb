# Analytics — leave unset to disable. Wire to your provider of choice
# (e.g. Plausible, Fathom). No analytics script loads without this.
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Netlify Blobs (form submission storage) is provisioned automatically
# per-site when deployed on Netlify. No configuration needed here; the
# vars below are only relevant for local `netlify dev` testing.
# NETLIFY_SITE_ID=
# NETLIFY_AUTH_TOKEN=
